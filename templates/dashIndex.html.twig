                    <div class="ecommerce-widget">

                        <div class="row">
                            <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div>
                                        <h5 class="text-muted">Users Online :  <span id="online-users-count"></span></h5>
                                        <ul id="online-users-list"></ul>
                                        </div>
                                       <script>
                                        // Function to fetch the number of online users and the list of online users
                                        function fetchOnlineUsers() {
                                            fetch('/api/online-users')
                                                .then(response => response.json())
                                                .then(data => {
                                                    document.getElementById('online-users-count').textContent = data.count;
                                                    renderOnlineUsersList(data.users);
                                                })
                                                .catch(error => console.error('Error fetching online users:', error));
                                        }

                                        // Function to render the list of online users
                                        function renderOnlineUsersList(users) {
                                            const listElement = document.getElementById('online-users-list');
                                            listElement.innerHTML = ''; // Clear previous list

                                            users.forEach(user => {
                                                const listItem = document.createElement('li');
                                                listItem.textContent = user.name; // Assuming each user has a 'name' property
                                                listElement.appendChild(listItem);
                                            });
                                        }

                                        // Fetch online users count and list on page load
                                        document.addEventListener('DOMContentLoaded', () => {
                                            fetchOnlineUsers();

                                            // Fetch online users count and list every 30 seconds
                                            setInterval(fetchOnlineUsers, 30000); // Adjust the interval as needed
                                        });
                                    </script>

                                    </div>
                                    
                                </div>
                            </div>
                            
                            
                            
