{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
    <h1>User</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ user.name }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>Phonenum</th>
                <td>{{ user.phonenum }}</td>
            </tr>
            <tr>
                <th>Gender</th>
                <td>{{ user.gender }}</td>
            </tr>
            <tr>
                <th>Adresse</th>
                <td>{{ user.adresse }}</td>
            </tr>
            <tr>
                <th>Age</th>
                <td>{{ user.age }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ user.password }}</td>
            </tr>
            <tr>
                <th>Joindate</th>
                <td>{{ user.joindate ? user.joindate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Role</th>
                <td>{{ user.role }}</td>
            </tr>
            <tr>
                <th>Height</th>
                <td>{{ user.height }}</td>
            </tr>
            <tr>
                <th>Weight</th>
                <td>{{ user.weight }}</td>
            </tr>
            <tr>
                <th>RecetteId</th>
                <td>{{ user.recetteId }}</td>
            </tr>
            <tr>
                <th>ConseilId</th>
                <td>{{ user.conseilId }}</td>
            </tr>
            <tr>
                <th>FeedbackId</th>
                <td>{{ user.feedbackId }}</td>
            </tr>
            <tr>
                <th>RecoveryCode</th>
                <td>{{ user.recoveryCode }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_auth_index') }}">back to list</a>

    <a href="{{ path('app_auth_edit', {'id': user.id}) }}">edit</a>

    {{ include('auth/_delete_form.html.twig') }}
{% endblock %}
