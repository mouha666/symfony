{% extends 'base.html.twig' %}

{% block css %}
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="container mt-5">
    <h2 class="mb-4">Shopping Cart</h2>

    <!-- Flash Messages -->
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <!-- Cart Table -->
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead class="thead-light">
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for item in products %}
                <tr>
                    <td>{{ item.product.name }}</td>
                    <td>{{ item.product.price|number_format(2) }} USD</td>
                    <td>
                        <input type="number" class="form-control" value="{{ item.quantity }}" min="1">
                    </td>
                    <td>{{ item.subtotal|number_format(2) }} USD</td>
                    <td>
                        <a href="{{ path('app_removefromcart', {'id': item.product.id}) }}" class="btn btn-danger btn-sm">Remove</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="text-center">Your cart is empty</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Cart Summary -->
    <div class="row">
        <div class="col-lg-6">
            <a href="{{ path('app_home') }}" class="btn btn-secondary">Continue Shopping</a>
        </div>
        <div class="col-lg-6 text-right">
            <h4>Total: {{ total|number_format(2) }} USD</h4>
            <script src="https://www.google.com/recaptcha/api.js" async defer></script>
            <form action="{{ path('app_checkout') }}" method="post">
                <div class="g-recaptcha" data-sitekey="6LevZNQpAAAAAEPxapAcKLFZqhgS5omyx5dfRfUx"></div>
                <button type="submit" class="btn btn-success">Proceed to Checkout</button>
                <a href="{{ path('export_to_excel') }}" class="btn btn-primary">Retrieve all Commands made</a>
            </form>
        </div>
    </div>
</div>
{% endblock %}

